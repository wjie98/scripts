# shellcheck shell=bash

# Claude Code backend launcher.
# Sourced from ~/.bashrc; defines `ccw` and `ccwp` (formerly `cc` and `ccp`).
#
#   ccw <backend> [claude-options...]        # named backend, permission prompts
#   ccw <port> [claude-options...]           # local 127.0.0.1:<port>
#   ccw host <port> [claude-options...]      # default-route gateway (WSL host)
#   ccw <ip> <port> [claude-options...]      # explicit IPv4/IPv6 address
#   ccwp ...                                 # same, appends --dangerously-skip-permissions
#
# Backends are configured in section 1. Local addresses use the local inference
# backend implemented in section 4.

# ------------------------------------------------------------------------------
# 修改边界（给后续会话 / 维护者）
#
# 除非明确要求，否则把“修改本文件”理解为当前配置入口的增删改查：
#   - 新增/删除后端：CC_BACKENDS + CC_BACKEND_<name>
#   - 调整全局环境变量：CC_GLOBAL_ENV
#   - 调整本地推理覆盖项：CC_LOCAL_*
#   - 调整某个后端：只改 CC_BACKEND_<name> 内的条目
#
# 不要顺手改动通用代码：
#   - 共享 helper、配置解析/校验/环境变量生成
#   - 后端查找、dispatch、本地推理探测流程
#   - 其他后端或全局默认值
#
# 如果配置改动看起来必须修改通用代码，先停下来说明原因并征求确认。
# ------------------------------------------------------------------------------

if [[ -z "${BASH_VERSINFO[0]:-}" ]] || (( BASH_VERSINFO[0] < 4 || (BASH_VERSINFO[0] == 4 && BASH_VERSINFO[1] < 3) )); then
    printf 'Error: cc.env requires bash 4.3 or newer.\n' >&2
    return 1 2>/dev/null || exit 1
fi

# ==============================================================================
# 1. Configuration
# ==============================================================================

# Shared environment variables applied to every named backend.
CC_GLOBAL_ENV=(
    "CLAUDE_CODE_ENABLE_TELEMETRY=0"
    "CLAUDE_CODE_ATTRIBUTION_HEADER=0"
    "CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC=1"
)

# Optional local-inference overrides. Set them inline for one launch:
#   CC_LOCAL_MODEL=my-model ccw 9100
#   CC_LOCAL_CONTEXT=65536 ccw host 9100
#   CC_LOCAL_TIMEOUT=300 ccw 9100
#   CC_LOCAL_TOKEN=secret ccw 9100
#
# CC_LOCAL_MODEL / CC_LOCAL_CONTEXT are unset by default, so the server is
# queried. CC_LOCAL_TIMEOUT is the curl request timeout in seconds; the connect
# timeout is fixed at 3 seconds. CC_LOCAL_TOKEN is the local server bearer
# token. Only DEEPSEEK_API_KEY is exported from this file.
CC_LOCAL_TIMEOUT="${CC_LOCAL_TIMEOUT:-120}"
CC_LOCAL_TOKEN="${CC_LOCAL_TOKEN:-local}"

# ------------------------------------------------------------------------------
# Backends
#
# Add a name to CC_BACKENDS, then define CC_BACKEND_<name> as key=value fields.
#
# Required:
#   base_url             Anthropic-compatible endpoint
#   model                main model
#
# Auth (one of; omit both for no-auth/OAuth setups):
#   auth_env             env var holding the token, resolved at launch
#     or auth_token      literal token (prefer auth_env; literal tokens leak)
#
# Optional:
#   aliases              space-separated aliases
#   description          help text
#   fast_model           Haiku/subagent model (default: model)
#   model_name           /model picker name (default: description or model)
#   capabilities         default: effort,max_effort,thinking
#   effort               CLAUDE_CODE_EFFORT_LEVEL
#   auto_compact_window  CLAUDE_CODE_AUTO_COMPACT_WINDOW
#                       (convention: 75% of the model window unless you
#                        specify otherwise, e.g. 750000 for 1M models)
#
# Arbitrary extra env vars, applied last so they can override generated values:
#   CC_BACKEND_<name>_EXTRA=("KEY=value" ...)
#
# Example:
#   CC_BACKEND_moonshot=(
#       "aliases=kimi"
#       "description=Moonshot kimi-k2.6"
#       "base_url=https://api.moonshot.cn/anthropic"
#       "auth_env=MOONSHOT_API_KEY"
#       "model=kimi-k2.6"
#   )
# ------------------------------------------------------------------------------

CC_BACKENDS=(
    ds
    zhipu
)

CC_BACKEND_ds=(
    "description=DeepSeek Flash (V4.1, multimodal)"
    "base_url=https://api.deepseek.com/anthropic"
    "auth_env=DEEPSEEK_API_KEY"
    "model=deepseek-flash[1m]"
    "fast_model=deepseek-flash"
    "model_name=DeepSeek Flash"
    "capabilities=effort,max_effort,thinking"
    "effort=max"
    "auto_compact_window=786432"
)

# Zhipu BigModel (GLM Coding Plan / Anthropic-compatible endpoint).
# All tiers use GLM-5.3, the text-only flagship.
CC_BACKEND_zhipu=(
    "aliases=glm bigmodel"
    "description=Zhipu GLM-5.3 (1M, text, strongest)"
    "base_url=https://open.bigmodel.cn/api/anthropic"
    "auth_env=ZAI_CODING_CN_API_KEY"
    "model=glm-5.3[1m]"
    "fast_model=glm-5.3[1m]"
    "model_name=GLM-5.3"
    "capabilities=effort,max_effort,thinking"
    "effort=max"
    "auto_compact_window=750000"
)

# ==============================================================================
# 2. Shared helpers
# ==============================================================================

_cc_die() {
    printf 'Error: %s\n' "$*" >&2
    return 1
}

_cc_warn() {
    printf 'Warning: %s\n' "$*" >&2
}

_cc_info() {
    printf '%s\n' "$*" >&2
}

_cc_is_valid_name() {
    [[ "${1}" =~ ^[A-Za-z_][A-Za-z0-9_]*$ ]]
}

_cc_is_valid_env_key() {
    [[ "${1}" =~ ^[A-Za-z_][A-Za-z0-9_]*$ ]]
}

_cc_apply_env_list() {
    local entry key value

    if (( $# == 0 )); then
        return 0
    fi

    for entry in "$@"; do
        if [[ "${entry}" != *=* ]]; then
            _cc_die "invalid environment entry '${entry}' (expected KEY=value)"
            return 1
        fi
        key="${entry%%=*}"
        value="${entry#*=}"
        if ! _cc_is_valid_env_key "${key}"; then
            _cc_die "invalid environment variable name '${key}'"
            return 1
        fi
        if ! export "${key}=${value}"; then
            _cc_die "cannot export ${key}"
            return 1
        fi
    done
}

_cc_clear_claude_env() {
    local name prefix
    local -a prefixes=("ANTHROPIC_" "CLAUDE_CODE_")
    local -a names=("CLAUDE_API_KEY" "CLAUDE_BASE_URL")

    while IFS= read -r name; do
        for prefix in "${prefixes[@]}"; do
            if [[ "${name}" == "${prefix}"* ]]; then
                unset "${name}"
                break
            fi
        done
    done < <(compgen -e)

    for name in "${names[@]}"; do
        unset "${name}"
    done
}

_cc_normalize_port() {
    local value="${1}"
    local port

    [[ "${value}" =~ ^[0-9]+$ ]] || return 1
    port=$((10#${value}))
    (( port >= 1 && port <= 65535 )) || return 1
    printf '%s\n' "${port}"
}

_cc_normalize_context() {
    local value="${1}"
    local context

    [[ "${value}" =~ ^[0-9]+$ ]] || return 1
    context=$((10#${value}))
    (( context > 0 )) || return 1
    printf '%s\n' "${context}"
}

_cc_normalize_timeout() {
    local value="${1}"
    local timeout

    [[ "${value}" =~ ^[0-9]+$ ]] || return 1
    timeout=$((10#${value}))
    (( timeout > 0 )) || return 1
    printf '%s\n' "${timeout}"
}

_cc_is_ipv4() {
    local value="${1}"
    local octet
    local -a octets=()

    [[ "${value}" =~ ^([0-9]{1,3}\.){3}[0-9]{1,3}$ ]] || return 1
    IFS='.' read -r -a octets <<< "${value}"
    for octet in "${octets[@]}"; do
        (( 10#${octet} <= 255 )) || return 1
    done
}

_cc_is_ipv6() {
    local value="${1}"

    if [[ "${value}" == \[*\] ]]; then
        value="${value#\[}"
        value="${value%\]}"
    fi
    [[ "${value}" == *:* ]] || return 1
    [[ "${value}" =~ ^[0-9A-Fa-f:.%]+$ ]]
}

_cc_normalize_host() {
    local value="${1}"

    if _cc_is_ipv4 "${value}"; then
        printf '%s\n' "${value}"
        return 0
    fi
    if _cc_is_ipv6 "${value}"; then
        value="${value#\[}"
        value="${value%\]}"
        printf '%s\n' "${value}"
        return 0
    fi
    return 1
}

_cc_format_host() {
    local host="${1}"

    if _cc_is_ipv6 "${host}"; then
        printf '[%s]\n' "${host}"
    else
        printf '%s\n' "${host}"
    fi
}

_cc_host_gateway() {
    local gateway

    command -v ip >/dev/null 2>&1 || return 1
    gateway="$(ip route show default 2>/dev/null | awk '{print $3; exit}')" || return 1
    [[ -n "${gateway}" ]] || return 1
    _cc_is_ipv4 "${gateway}" || return 1
    printf '%s\n' "${gateway}"
}

_cc_http_status_has_route() {
    local status="${1}"

    case "${status}" in
        2??|3??|400|409|413|415|422|429) return 0 ;;
        *) return 1 ;;
    esac
}

_cc_http_status_is_auth_failure() {
    case "${1}" in
        401|403) return 0 ;;
        *) return 1 ;;
    esac
}

_cc_http_status_is_server_failure() {
    case "${1}" in
        5??) return 0 ;;
        *) return 1 ;;
    esac
}

# ==============================================================================
# 3. Backend configuration
# ==============================================================================

_cc_backend_exists() {
    local name="${1}"
    local var decl

    _cc_is_valid_name "${name}" || return 1
    var="CC_BACKEND_${name}"
    decl="$(declare -p "${var}" 2>/dev/null)" || return 1
    [[ "${decl}" == "declare -a"* ]] || return 1

    local -n ref="${var}"
    (( ${#ref[@]} > 0 ))
}

_cc_backend_field() {
    local name="${1}"
    local field="${2}"
    local entry

    _cc_backend_exists "${name}" || return 1
    local -n ref="CC_BACKEND_${name}"

    for entry in "${ref[@]}"; do
        if [[ "${entry}" == "${field}="* ]]; then
            printf '%s\n' "${entry#*=}"
            return 0
        fi
    done

    return 1
}

_cc_validate_env_entries() {
    local label="${1}"
    shift
    local entry key value
    local -A seen=()

    for entry in "$@"; do
        if [[ "${entry}" != *=* ]]; then
            _cc_die "${label}: invalid entry '${entry}' (expected KEY=value)"
            return 1
        fi
        key="${entry%%=*}"
        value="${entry#*=}"
        if ! _cc_is_valid_env_key "${key}"; then
            _cc_die "${label}: invalid variable name '${key}'"
            return 1
        fi
        if [[ -n "${seen[${key}]+x}" ]]; then
            _cc_die "${label}: duplicate variable '${key}'"
            return 1
        fi
        seen["${key}"]=1
        if [[ "${value}" == *"{model}"* ]]; then
            _cc_die "${label}: '{model}' is no longer supported; use model/fast_model fields"
            return 1
        fi
    done

    return 0
}

_cc_parse_backend() {
    local name="${1}"
    local -n fields="${2}"
    local entry key value field
    local -a allowed=(
        aliases description base_url auth_env auth_token model fast_model
        model_name capabilities effort auto_compact_window
    )
    local -A allowed_map=()
    local auth_env auth_token window

    _cc_backend_exists "${name}" || {
        _cc_die "backend '${name}': missing or empty CC_BACKEND_${name} array"
        return 1
    }

    local -n entries="CC_BACKEND_${name}"
    fields=()

    for field in "${allowed[@]}"; do
        allowed_map["${field}"]=1
    done

    for entry in "${entries[@]}"; do
        if [[ "${entry}" != *=* ]]; then
            _cc_die "backend '${name}': invalid entry '${entry}' (expected key=value)"
            return 1
        fi
        key="${entry%%=*}"
        value="${entry#*=}"
        if ! _cc_is_valid_env_key "${key}"; then
            _cc_die "backend '${name}': invalid field name '${key}'"
            return 1
        fi
        if [[ -z "${allowed_map[${key}]+x}" ]]; then
            _cc_die "backend '${name}': unknown field '${key}'"
            return 1
        fi
        if [[ -n "${fields[${key}]+x}" ]]; then
            _cc_die "backend '${name}': duplicate field '${key}'"
            return 1
        fi
        fields["${key}"]="${value}"
    done

    if [[ -z "${fields[base_url]:-}" ]]; then
        _cc_die "backend '${name}': missing required field 'base_url'"
        return 1
    fi
    if [[ -z "${fields[model]:-}" ]]; then
        _cc_die "backend '${name}': missing required field 'model'"
        return 1
    fi

    auth_env="${fields[auth_env]:-}"
    auth_token="${fields[auth_token]:-}"
    if [[ -n "${fields[auth_env]+x}" && -z "${auth_env}" ]]; then
        _cc_die "backend '${name}': auth_env must not be empty"
        return 1
    fi
    if [[ -n "${fields[auth_token]+x}" && -z "${auth_token}" ]]; then
        _cc_die "backend '${name}': auth_token must not be empty"
        return 1
    fi
    if [[ -n "${auth_env}" && -n "${auth_token}" ]]; then
        _cc_die "backend '${name}': auth_env and auth_token are mutually exclusive"
        return 1
    fi
    if [[ -n "${auth_env}" ]] && ! _cc_is_valid_name "${auth_env}"; then
        _cc_die "backend '${name}': auth_env '${auth_env}' is not a valid variable name"
        return 1
    fi

    window="${fields[auto_compact_window]:-}"
    if [[ -n "${window}" ]]; then
        if [[ ! "${window}" =~ ^[0-9]+$ ]] || (( 10#${window} < 1 )); then
            _cc_die "backend '${name}': auto_compact_window must be a positive integer"
            return 1
        fi
        if (( 10#${window} < 100000 || 10#${window} > 1000000 )); then
            _cc_warn "backend '${name}': auto_compact_window ${window} is outside 100000-1000000; Claude Code may ignore it"
        fi
    fi

    if [[ -z "${fields[fast_model]:-}" ]]; then
        fields[fast_model]="${fields[model]}"
    fi
    if [[ -z "${fields[model_name]:-}" ]]; then
        fields[model_name]="${fields[description]:-${fields[model]}}"
    fi
    if [[ -z "${fields[capabilities]:-}" ]]; then
        fields[capabilities]="effort,max_effort,thinking"
    fi

    return 0
}

_cc_validate_config() {
    local name alias extra_var decl
    local -A seen_names=()
    local -A seen_aliases=()
    local -A spec=()
    local -a alias_list=()

    for name in "${CC_BACKENDS[@]}"; do
        if [[ "${name}" == *"|"* ]]; then
            _cc_die "cc.env: old backend format detected ('${name}'); use CC_BACKENDS=(name) plus CC_BACKEND_<name> key=value fields"
            return 1
        fi
        if ! _cc_is_valid_name "${name}"; then
            _cc_die "cc.env: invalid backend name '${name}'"
            return 1
        fi
        case "${name}" in
            host|help)
                _cc_die "cc.env: backend name '${name}' is reserved"
                return 1
                ;;
        esac
        if [[ "${name}" == *_EXTRA ]]; then
            _cc_die "cc.env: backend name '${name}' conflicts with the _EXTRA suffix"
            return 1
        fi
        if [[ -n "${seen_names[${name}]+x}" ]]; then
            _cc_die "cc.env: duplicate backend '${name}'"
            return 1
        fi
        seen_names["${name}"]=1
    done

    for name in "${CC_BACKENDS[@]}"; do
        if ! _cc_parse_backend "${name}" spec; then
            return 1
        fi

        if [[ -n "${spec[aliases]:-}" ]]; then
            read -r -a alias_list <<< "${spec[aliases]}"
            for alias in "${alias_list[@]}"; do
                if [[ ! "${alias}" =~ ^[A-Za-z_][A-Za-z0-9_.-]*$ ]]; then
                    _cc_die "backend '${name}': invalid alias '${alias}' (letters, digits, '.', '_' or '-'; must start with a letter or '_')"
                    return 1
                fi
                case "${alias}" in
                    host|help)
                        _cc_die "backend '${name}': alias '${alias}' is reserved"
                        return 1
                        ;;
                esac
                if [[ -n "${seen_names[${alias}]+x}" ]]; then
                    _cc_die "backend '${name}': alias '${alias}' collides with a backend name"
                    return 1
                fi
                if [[ -n "${seen_aliases[${alias}]+x}" ]]; then
                    _cc_die "backend '${name}': duplicate alias '${alias}'"
                    return 1
                fi
                seen_aliases["${alias}"]=1
            done
        fi

        extra_var="CC_BACKEND_${name}_EXTRA"
        if declare -p "${extra_var}" >/dev/null 2>&1; then
            decl="$(declare -p "${extra_var}" 2>/dev/null)" || decl=""
            if [[ "${decl}" != "declare -a"* ]]; then
                _cc_die "backend '${name}': ${extra_var} must be an indexed array"
                return 1
            fi
            local -n extra_ref="${extra_var}"
            _cc_validate_env_entries "backend '${name}' extra" "${extra_ref[@]}" || {
                unset -n extra_ref
                return 1
            }
            unset -n extra_ref
        fi
    done

    _cc_validate_env_entries "CC_GLOBAL_ENV" "${CC_GLOBAL_ENV[@]}" || return 1

    return 0
}

_cc_find_backend() {
    local requested="${1}"
    local name aliases alias
    local -a alias_list=()

    for name in "${CC_BACKENDS[@]}"; do
        if [[ "${requested}" == "${name}" ]]; then
            printf '%s\n' "${name}"
            return 0
        fi

        aliases="$(_cc_backend_field "${name}" aliases 2>/dev/null)" || aliases=""
        read -r -a alias_list <<< "${aliases}"
        for alias in "${alias_list[@]}"; do
            if [[ "${requested}" == "${alias}" ]]; then
                printf '%s\n' "${name}"
                return 0
            fi
        done
    done

    return 1
}

_cc_build_backend_env() {
    local name="${1}"
    local -n _cc_env_ref="${2}"
    local -A spec=()
    local entry value decl
    local auth_env auth_token auth_value
    local model fast_model model_name capabilities

    _cc_parse_backend "${name}" spec || return 1

    model="${spec[model]}"
    fast_model="${spec[fast_model]}"
    model_name="${spec[model_name]}"
    capabilities="${spec[capabilities]}"

    _cc_env_ref=(
        "ANTHROPIC_BASE_URL=${spec[base_url]}"
        "ANTHROPIC_MODEL=${model}"
        "ANTHROPIC_DEFAULT_OPUS_MODEL=${model}"
        "ANTHROPIC_DEFAULT_SONNET_MODEL=${model}"
        "ANTHROPIC_DEFAULT_FABLE_MODEL=${model}"
        "ANTHROPIC_DEFAULT_HAIKU_MODEL=${fast_model}"
        "ANTHROPIC_DEFAULT_OPUS_MODEL_NAME=${model_name}"
        "ANTHROPIC_DEFAULT_SONNET_MODEL_NAME=${model_name}"
        "ANTHROPIC_DEFAULT_HAIKU_MODEL_NAME=${model_name}"
        "ANTHROPIC_DEFAULT_FABLE_MODEL_NAME=${model_name}"
        "ANTHROPIC_DEFAULT_OPUS_MODEL_SUPPORTED_CAPABILITIES=${capabilities}"
        "ANTHROPIC_DEFAULT_SONNET_MODEL_SUPPORTED_CAPABILITIES=${capabilities}"
        "ANTHROPIC_DEFAULT_HAIKU_MODEL_SUPPORTED_CAPABILITIES=${capabilities}"
        "ANTHROPIC_DEFAULT_FABLE_MODEL_SUPPORTED_CAPABILITIES=${capabilities}"
        "CLAUDE_CODE_SUBAGENT_MODEL=${fast_model}"
    )

    auth_env="${spec[auth_env]:-}"
    auth_token="${spec[auth_token]:-}"
    if [[ -n "${auth_env}" ]]; then
        if [[ -v "${auth_env}" ]]; then
            auth_value="${!auth_env}"
        else
            auth_value=""
        fi
        if [[ -z "${auth_value}" ]]; then
            _cc_die "backend '${name}' requires environment variable ${auth_env}, but it is unset or empty."
            _cc_info "Export ${auth_env}, then retry."
            return 1
        fi
        _cc_env_ref+=("ANTHROPIC_AUTH_TOKEN=${auth_value}")
    elif [[ -n "${auth_token}" ]]; then
        _cc_env_ref+=("ANTHROPIC_AUTH_TOKEN=${auth_token}")
    fi

    if [[ -n "${spec[effort]:-}" ]]; then
        _cc_env_ref+=("CLAUDE_CODE_EFFORT_LEVEL=${spec[effort]}")
    fi
    if [[ -n "${spec[auto_compact_window]:-}" ]]; then
        _cc_env_ref+=("CLAUDE_CODE_AUTO_COMPACT_WINDOW=${spec[auto_compact_window]}")
    fi

    local extra_var="CC_BACKEND_${name}_EXTRA"
    if declare -p "${extra_var}" >/dev/null 2>&1; then
        decl="$(declare -p "${extra_var}" 2>/dev/null)" || decl=""
        if [[ "${decl}" != "declare -a"* ]]; then
            _cc_die "backend '${name}': ${extra_var} must be an indexed array"
            return 1
        fi
        local -n extra_ref="${extra_var}"
        _cc_validate_env_entries "backend '${name}' extra" "${extra_ref[@]}" || {
            unset -n extra_ref
            return 1
        }
        for entry in "${extra_ref[@]}"; do
            _cc_env_ref+=("${entry}")
        done
        unset -n extra_ref
    fi

    for entry in "${_cc_env_ref[@]}"; do
        case "${entry}" in
            ANTHROPIC_AUTH_TOKEN=*|ANTHROPIC_API_KEY=*)
                value="${entry#*=}"
                if [[ -z "${value}" ]]; then
                    _cc_die "backend '${name}' has an empty ${entry%%=*} after applying extra env."
                    return 1
                fi
                ;;
        esac
    done

    return 0
}

_cc_print_help() {
    local name aliases description

    cat << EOF
Usage:
  ccw <backend> [claude-options...]        # named backend, keeps permission prompts
  ccw <port> [claude-options...]           # local 127.0.0.1:<port>
  ccw host <port> [claude-options...]      # default-route gateway (WSL host)
  ccw <ip> <port> [claude-options...]      # explicit IPv4/IPv6 address
  ccwp ...                                 # same, appends --dangerously-skip-permissions

ccw/ccwp replace the former cc/ccp names to avoid clashing with /usr/bin/cc.

Available backends (${#CC_BACKENDS[@]}):
EOF

    for name in "${CC_BACKENDS[@]}"; do
        aliases="$(_cc_backend_field "${name}" aliases 2>/dev/null)" || aliases=""
        description="$(_cc_backend_field "${name}" description 2>/dev/null)" || description=""
        if [[ -z "${description}" ]]; then
            description="$(_cc_backend_field "${name}" model 2>/dev/null)" || description=""
        fi

        if [[ -n "${aliases}" ]]; then
            printf '  %-12s %s (aliases: %s)\n' "${name}" "${description}" "${aliases}"
        else
            printf '  %-12s %s\n' "${name}" "${description}"
        fi
    done

    cat << EOF

Local inference server:
  ccw <port> uses 127.0.0.1. ccw host <port> resolves the IPv4 default-route
  gateway (the Windows host under WSL). ccw <ip> <port> uses an explicit
  address. Models are discovered through OpenAI /v1/models (falling back to
  /models), the context through model metadata, SGLang /get_server_info, or
  llama.cpp /props, and the Anthropic Messages endpoint is verified before
  launch.

  One advertised model is used automatically. 2-9 models open an interactive
  menu; more than 9 reports the list and asks for CC_LOCAL_MODEL. Launches
  without a terminal must set CC_LOCAL_MODEL.

  Overrides:
    CC_LOCAL_MODEL    force a model ID
    CC_LOCAL_CONTEXT  force a context length (skips detection)
    CC_LOCAL_TIMEOUT  request timeout in seconds (default 120)
    CC_LOCAL_TOKEN    bearer token for the local server (default local)

  Existing http_proxy/HTTP_PROXY settings are preserved, so a Windows Clash
  proxy can relay WSL requests to a Windows-hosted inference service.

Examples:
  ccw ds
  ccw ds --version
  ccw 9100
  ccw host 9100
  ccw 192.168.1.20 9100
  ccw ds -p "hello"
  ccwp ds -p "hello"

Add or update backends in the Configuration section.
EOF
}

# ==============================================================================
# 4. Local inference backend
# ==============================================================================

_cc_local_curl() {
    curl \
        --silent \
        --show-error \
        --fail-with-body \
        --connect-timeout 3 \
        --max-time "${CC_LOCAL_TIMEOUT:-120}" \
        --header "Authorization: Bearer ${CC_LOCAL_TOKEN:-local}" \
        --header "x-api-key: ${CC_LOCAL_TOKEN:-local}" \
        "$@"
}

_cc_local_http_status() {
    curl \
        --silent \
        --show-error \
        --connect-timeout 3 \
        --max-time "${CC_LOCAL_TIMEOUT:-120}" \
        --output /dev/null \
        --write-out '%{http_code}' \
        --header "Authorization: Bearer ${CC_LOCAL_TOKEN:-local}" \
        --header "x-api-key: ${CC_LOCAL_TOKEN:-local}" \
        "$@"
}

_cc_json_model_ids() {
    python3 -I -c '
import json
import sys

document = json.load(sys.stdin)
items = document.get("data") if isinstance(document, dict) else None
if not isinstance(items, list) and isinstance(document, dict):
    items = document.get("models")
if not isinstance(items, list) and isinstance(document, list):
    items = document
if not isinstance(items, list):
    items = []

seen = set()
for item in items:
    if isinstance(item, str):
        model_id = item
        failed = False
    elif isinstance(item, dict):
        model_id = item.get("id") or item.get("model") or item.get("name")
        status = item.get("status") or {}
        failed = isinstance(status, dict) and bool(status.get("failed", False))
    else:
        continue
    if isinstance(model_id, str) and model_id and not failed and model_id not in seen:
        seen.add(model_id)
        print(model_id)
'
}

_cc_json_model_context() {
    python3 -I -c '
import json
import sys

document = json.load(sys.stdin)
selected_model = sys.argv[1]

def items_from(value):
    if isinstance(value, dict):
        items = value.get("data")
        if not isinstance(items, list):
            items = value.get("models")
        return items if isinstance(items, list) else []
    return value if isinstance(value, list) else []

def model_id(item):
    if not isinstance(item, dict):
        return item if isinstance(item, str) else None
    return item.get("id") or item.get("model") or item.get("name")

def positive_int(value):
    if isinstance(value, bool):
        return None
    if isinstance(value, int) and value > 0:
        return value
    if isinstance(value, str) and value.isdigit() and int(value) > 0:
        return int(value)
    if isinstance(value, dict):
        for key in ("tokens", "size", "max_tokens", "length"):
            parsed = positive_int(value.get(key))
            if parsed is not None:
                return parsed
    return None

def find_key(value, wanted):
    if isinstance(value, dict):
        if wanted in value:
            parsed = positive_int(value[wanted])
            if parsed is not None:
                return parsed
        for nested in value.values():
            parsed = find_key(nested, wanted)
            if parsed is not None:
                return parsed
    elif isinstance(value, list):
        for nested in value:
            parsed = find_key(nested, wanted)
            if parsed is not None:
                return parsed
    return None

items = items_from(document)
target = next((item for item in items if model_id(item) == selected_model), None)
if target is None and len(items) == 1:
    target = items[0]
if not isinstance(target, dict):
    raise SystemExit(1)

for key in (
    "context_length",
    "context_window",
    "max_context_length",
    "max_context_window",
    "max_model_len",
    "max_position_embeddings",
    "n_ctx",
):
    value = find_key(target, key)
    if value is not None:
        print(value)
        raise SystemExit(0)
raise SystemExit(1)
' "${1}"
}

_cc_json_server_context() {
    python3 -I -c '
import json
import sys

document = json.load(sys.stdin)

def positive_int(value):
    if isinstance(value, bool):
        return None
    if isinstance(value, int) and value > 0:
        return value
    if isinstance(value, str) and value.isdigit() and int(value) > 0:
        return int(value)
    return None

def find_key(value, wanted):
    if isinstance(value, dict):
        if wanted in value:
            parsed = positive_int(value[wanted])
            if parsed is not None:
                return parsed
        for nested in value.values():
            parsed = find_key(nested, wanted)
            if parsed is not None:
                return parsed
    elif isinstance(value, list):
        for nested in value:
            parsed = find_key(nested, wanted)
            if parsed is not None:
                return parsed
    return None

for key in (
    "context_length",
    "context_len",
    "max_context_length",
    "max_context_window",
    "max_model_len",
    "max_position_embeddings",
    "n_ctx",
):
    value = find_key(document, key)
    if value is not None:
        print(value)
        raise SystemExit(0)
raise SystemExit(1)
'
}

_cc_json_count_tokens_payload() {
    python3 -I -c '
import json
import sys

print(json.dumps({
    "model": sys.argv[1],
    "messages": [{"role": "user", "content": "ping"}],
}))
' "${1}"
}

_cc_json_validate_count_tokens() {
    python3 -I -c '
import json
import sys

document = json.load(sys.stdin)
value = document.get("input_tokens")
if not isinstance(value, int) or isinstance(value, bool) or value < 0:
    raise SystemExit(1)
'
}

_cc_list_models() {
    local model

    for model in "$@"; do
        printf '  %s\n' "${model}" >&2
    done
}

_cc_local_discover_models() {
    local -n st="${1}"
    local required="${2:-1}"
    local models_json model_lines

    models_json="$(_cc_local_curl "${st[base_url]}/v1/models" 2>/dev/null)" || models_json=""
    st[models_json]="${models_json}"
    st[model_lines]=""
    st[discovery_source]=""
    st[discovery_status]=""

    if [[ -n "${models_json}" ]]; then
        model_lines="$(printf '%s' "${models_json}" | _cc_json_model_ids 2>/dev/null)" || model_lines=""
        if [[ -n "${model_lines}" ]]; then
            st[model_lines]="${model_lines}"
            st[discovery_source]="OpenAI /v1/models"
            return 0
        fi
    fi

    st[discovery_status]="$(_cc_local_http_status "${st[base_url]}/v1/models" 2>/dev/null)" || st[discovery_status]="000"
    if _cc_http_status_is_auth_failure "${st[discovery_status]}"; then
        if (( required )); then
            _cc_die "model discovery at ${st[base_url]} rejected the credentials (HTTP ${st[discovery_status]})."
            _cc_info "Check CC_LOCAL_TOKEN and retry."
            return 1
        fi
        _cc_warn "model discovery at ${st[base_url]} rejected the credentials (HTTP ${st[discovery_status]}); continuing with the supplied model."
        return 0
    fi
    if _cc_http_status_is_server_failure "${st[discovery_status]}"; then
        _cc_warn "/v1/models at ${st[base_url]} returned HTTP ${st[discovery_status]}; trying the /models fallback."
    fi

    models_json="$(_cc_local_curl "${st[base_url]}/models" 2>/dev/null)" || {
        if (( required )); then
            _cc_die "cannot discover models from ${st[base_url]}. /v1/models returned HTTP ${st[discovery_status]:-unknown}, and the /models fallback failed."
            _cc_info "Check that the inference server is running, reachable from this host, and accepts CC_LOCAL_TOKEN."
            return 1
        fi
        _cc_warn "model discovery failed at ${st[base_url]}; continuing with the supplied model."
        return 0
    }
    st[models_json]="${models_json}"
    model_lines="$(printf '%s' "${models_json}" | _cc_json_model_ids 2>/dev/null)" || {
        if (( required )); then
            _cc_die "${st[base_url]}/models returned invalid model metadata."
            return 1
        fi
        _cc_warn "${st[base_url]}/models returned invalid model metadata; continuing with the supplied model."
        return 0
    }
    if [[ -z "${model_lines}" ]]; then
        if (( required )); then
            _cc_die "No usable model is available from ${st[base_url]}."
            return 1
        fi
        _cc_warn "no usable model is advertised by ${st[base_url]}; continuing with the supplied model."
        return 0
    fi
    st[model_lines]="${model_lines}"
    st[discovery_source]="fallback /models"

    return 0
}

_cc_local_choose_model() {
    local -n _cc_model_ref="${1}"
    local -a models=()
    local choice

    mapfile -t models <<< "${_cc_model_ref[model_lines]}"

    if (( ${#models[@]} > 9 )); then
        _cc_die "server advertises ${#models[@]} models; interactive selection supports at most 9."
        _cc_list_models "${models[@]}"
        _cc_info "Set CC_LOCAL_MODEL to one of the IDs above."
        return 1
    fi

    if [[ ! -t 0 ]]; then
        _cc_die "cannot prompt for a model because stdin is not a terminal."
        _cc_list_models "${models[@]}"
        _cc_info "Set CC_LOCAL_MODEL to one of the IDs above."
        return 1
    fi

    PS3="Select model [1-${#models[@]}]: "
    select choice in "${models[@]}"; do
        if [[ -n "${choice}" ]]; then
            _cc_model_ref[model]="${choice}"
            _cc_info "Using local model: ${choice}"
            return 0
        fi
        printf 'Invalid selection.\n' >&2
    done
    return 1
}

_cc_local_select_model() {
    local -n st="${1}"
    local candidate
    local -a models=()

    if [[ -n "${st[model_lines]}" ]]; then
        mapfile -t models <<< "${st[model_lines]}"
    fi

    if [[ -n "${CC_LOCAL_MODEL:-}" ]]; then
        if (( ${#models[@]} == 0 )); then
            st[model]="${CC_LOCAL_MODEL}"
            return 0
        fi
        for candidate in "${models[@]}"; do
            if [[ "${candidate}" == "${CC_LOCAL_MODEL}" ]]; then
                st[model]="${candidate}"
                return 0
            fi
        done
        _cc_die "requested local model '${CC_LOCAL_MODEL}' is not advertised by ${st[base_url]}."
        _cc_list_models "${models[@]}"
        _cc_info "Set CC_LOCAL_MODEL to one of the IDs above, or unset it to choose interactively."
        return 1
    fi

    if (( ${#models[@]} == 0 )); then
        _cc_die "no model was specified and ${st[base_url]} did not advertise any models."
        _cc_info "Set CC_LOCAL_MODEL explicitly and retry."
        return 1
    fi

    if (( ${#models[@]} == 1 )); then
        st[model]="${models[0]}"
        return 0
    fi

    _cc_local_choose_model "${1}"
}

_cc_local_detect_context() {
    local -n st="${1}"
    local server_info_json="" props_json="" context

    if [[ -n "${CC_LOCAL_CONTEXT:-}" ]]; then
        context="$(_cc_normalize_context "${CC_LOCAL_CONTEXT}")" || {
            _cc_die "CC_LOCAL_CONTEXT must be a positive integer token count."
            return 1
        }
        st[context]="${context}"
        st[context_source]="CC_LOCAL_CONTEXT"
        return 0
    fi

    if [[ -n "${st[models_json]}" ]]; then
        context="$(printf '%s' "${st[models_json]}" | _cc_json_model_context "${st[model]}" 2>/dev/null)" || context=""
        if [[ -n "${context}" ]]; then
            st[context]="${context}"
            st[context_source]="model discovery metadata"
            return 0
        fi
    fi

    server_info_json="$(_cc_local_curl "${st[base_url]}/get_server_info" 2>/dev/null)" || server_info_json=""
    st[server_info_json]="${server_info_json}"
    if [[ -n "${server_info_json}" ]]; then
        st[backend_hint]="SGLang-compatible"
        context="$(printf '%s' "${server_info_json}" | _cc_json_server_context 2>/dev/null)" || context=""
        if [[ -n "${context}" ]]; then
            st[context]="${context}"
            st[context_source]="SGLang /get_server_info"
            return 0
        fi
    fi

    props_json="$(_cc_local_curl \
        --get \
        --data-urlencode "model=${st[model]}" \
        "${st[base_url]}/props" 2>/dev/null)" || props_json=""
    st[props_json]="${props_json}"
    if [[ -n "${props_json}" && "${st[backend_hint]}" == "OpenAI-compatible" ]]; then
        st[backend_hint]="llama.cpp-compatible"
    fi
    if [[ -n "${props_json}" ]]; then
        context="$(printf '%s' "${props_json}" | _cc_json_server_context 2>/dev/null)" || context=""
        if [[ -n "${context}" ]]; then
            st[context]="${context}"
            st[context_source]="llama.cpp /props"
            return 0
        fi
    fi

    _cc_die "Could not detect the context length for model ${st[model]} from ${st[base_url]}."
    _cc_info "Set it explicitly, for example: CC_LOCAL_CONTEXT=65536 ccw ${st[port]}"
    return 1
}

_cc_local_probe_protocol() {
    local -n st="${1}"
    local count_payload count_json

    st[openai_status]="$(_cc_local_http_status \
        --header "Content-Type: application/json" \
        --request POST \
        --data-binary '{}' \
        "${st[base_url]}/v1/chat/completions" 2>/dev/null)" || st[openai_status]="000"

    count_payload="$(_cc_json_count_tokens_payload "${st[model]}")" || {
        _cc_die "failed to build the count_tokens request payload."
        return 1
    }
    count_json="$(_cc_local_curl \
        --header "Content-Type: application/json" \
        --request POST \
        --data-binary "${count_payload}" \
        "${st[base_url]}/v1/messages/count_tokens" 2>/dev/null)" || count_json=""

    if [[ -n "${count_json}" ]] && printf '%s' "${count_json}" | _cc_json_validate_count_tokens 2>/dev/null; then
        st[anthropic_capability]="/v1/messages + /v1/messages/count_tokens"
        return 0
    fi

    st[anthropic_status]="$(_cc_local_http_status \
        --header "Content-Type: application/json" \
        --request POST \
        --data-binary '{}' \
        "${st[base_url]}/v1/messages" 2>/dev/null)" || st[anthropic_status]="000"

    if _cc_http_status_is_auth_failure "${st[anthropic_status]}"; then
        _cc_die "Anthropic /v1/messages exists at ${st[base_url]} but rejected the credentials (HTTP ${st[anthropic_status]})."
        _cc_info "Check CC_LOCAL_TOKEN and retry."
        return 1
    elif _cc_http_status_is_server_failure "${st[anthropic_status]}"; then
        _cc_die "Anthropic /v1/messages at ${st[base_url]} returned HTTP ${st[anthropic_status]} (server error)."
        _cc_info "The inference server is reachable but reported a failure; check its logs and retry."
        return 1
    elif _cc_http_status_has_route "${st[anthropic_status]}"; then
        st[anthropic_capability]="/v1/messages (count_tokens not confirmed)"
        _cc_warn "Anthropic /v1/messages exists, but /v1/messages/count_tokens was not confirmed."
        return 0
    else
        _cc_die "Anthropic /v1/messages is unavailable at ${st[base_url]} (HTTP ${st[anthropic_status]})."
        _cc_info "Claude Code cannot send requests directly to an OpenAI-only /v1/chat/completions endpoint."
        _cc_info "Use a recent SGLang build with Anthropic routes enabled, or place an Anthropic-to-OpenAI adapter in front of this server."
        return 1
    fi
}

_cc_local_report() {
    local -n st="${1}"

    _cc_info "Local inference server ready: ${st[base_url]}"
    _cc_info "  backend hint: ${st[backend_hint]}"
    _cc_info "  discovery: ${st[discovery_source]}"
    if _cc_http_status_has_route "${st[openai_status]}"; then
        _cc_info "  OpenAI chat: /v1/chat/completions"
    elif _cc_http_status_is_auth_failure "${st[openai_status]}"; then
        _cc_info "  OpenAI chat: route exists but credentials rejected (HTTP ${st[openai_status]})"
    elif _cc_http_status_is_server_failure "${st[openai_status]}"; then
        _cc_info "  OpenAI chat: server error (HTTP ${st[openai_status]})"
    else
        _cc_info "  OpenAI chat: not confirmed (HTTP ${st[openai_status]})"
    fi
    _cc_info "  Claude protocol: ${st[anthropic_capability]}"
    _cc_info "  model: ${st[model]}"
    _cc_info "  runtime context: ${st[context]} tokens (${st[context_source]})"

    return 0
}

_cc_preflight_local_backend() {
    local host="${1}"
    local port="${2}"
    local -A state=()
    local timeout require_models=0

    if ! command -v curl >/dev/null 2>&1; then
        _cc_die "curl is required to inspect the local inference server."
        return 1
    fi
    if ! command -v python3 >/dev/null 2>&1; then
        _cc_die "python3 is required to parse inference-server metadata."
        return 1
    fi

    timeout="$(_cc_normalize_timeout "${CC_LOCAL_TIMEOUT:-120}")" || {
        _cc_die "CC_LOCAL_TIMEOUT must be a positive integer."
        return 1
    }
    CC_LOCAL_TIMEOUT="${timeout}"

    state[port]="${port}"
    state[host]="${host}"
    state[base_url]="http://$(_cc_format_host "${host}"):${port}"
    state[backend_hint]="OpenAI-compatible"
    state[discovery_source]=""
    state[models_json]=""
    state[model_lines]=""
    state[model]=""
    state[server_info_json]=""
    state[props_json]=""
    state[context]=""
    state[context_source]=""
    state[openai_status]=""
    state[anthropic_status]=""
    state[anthropic_capability]=""
    state[discovery_status]=""

    if [[ -z "${CC_LOCAL_MODEL:-}" ]]; then
        require_models=1
    fi

    if [[ -n "${CC_LOCAL_MODEL:-}" && -n "${CC_LOCAL_CONTEXT:-}" ]]; then
        state[discovery_source]="skipped (model and context supplied)"
    else
        _cc_local_discover_models state "${require_models}" || return 1
    fi

    _cc_local_select_model state || return 1
    _cc_local_detect_context state || return 1
    _cc_local_probe_protocol state || return 1
    _cc_local_report state || return 1

    CC_LOCAL_DETECTED_MODEL="${state[model]}"
    CC_LOCAL_DETECTED_CONTEXT="${state[context]}"
}

_cc_apply_local_backend() {
    local host="${1}"
    local port="${2}"
    local model="${3}"
    local runtime_context="${4}"
    local base_url="http://$(_cc_format_host "${host}"):${port}"
    local -a local_env=(
        "ANTHROPIC_BASE_URL=${base_url}"
        "ANTHROPIC_AUTH_TOKEN=${CC_LOCAL_TOKEN:-local}"
        "ANTHROPIC_MODEL=${model}"
        "ANTHROPIC_DEFAULT_OPUS_MODEL=${model}"
        "ANTHROPIC_DEFAULT_SONNET_MODEL=${model}"
        "ANTHROPIC_DEFAULT_HAIKU_MODEL=${model}"
        "ANTHROPIC_DEFAULT_FABLE_MODEL=${model}"
        "CLAUDE_CODE_SUBAGENT_MODEL=${model}"
        # Tell Claude Code the model's actual hard context limit. The
        # auto-compact window defaults to 75% of that limit, clamped into
        # Claude Code's accepted 100000-1000000 range; at or below 100000
        # the window is left unset and the declared hard limit drives
        # proactive compaction instead.
        "CLAUDE_CODE_MAX_CONTEXT_TOKENS=${runtime_context}"
        "CLAUDE_CODE_MAX_RETRIES=1"
        # Local server decodes one request at a time (--max-concurrency 1)
        # but keeps two KV sessions warm (--kvmem-sessions 2): allow the
        # main conversation plus ONE subagent interleaving without
        # re-prefill, and block any further subagent until it finishes.
        "CLAUDE_CODE_MAX_CONCURRENT_SUBAGENTS=1"
    )
    local compact_window=$(( runtime_context * 3 / 4 ))

    if (( runtime_context <= 100000 )); then
        _cc_warn "runtime context ${runtime_context} is at or below 100000; leaving CLAUDE_CODE_AUTO_COMPACT_WINDOW unset (Claude Code accepts 100000-1000000)."
    else
        if (( compact_window < 100000 )); then
            _cc_warn "75% of runtime context ${runtime_context} is ${compact_window}, below the 100000 minimum; using 100000 instead."
            compact_window=100000
        fi
        if (( compact_window > 1000000 )); then
            _cc_warn "75% of runtime context ${runtime_context} exceeds 1000000; capping CLAUDE_CODE_AUTO_COMPACT_WINDOW at 1000000."
            compact_window=1000000
        fi
        local_env+=("CLAUDE_CODE_AUTO_COMPACT_WINDOW=${compact_window}")
    fi

    _cc_apply_env_list "${local_env[@]}"
}

# ==============================================================================
# 5. Dispatch
# ==============================================================================

_cc_resolve_target() {
    local -n _cc_target_ref="${1}"
    local arg="${2:-}"
    local second="${3:-}"
    local host port

    _cc_target_ref=()

    if [[ -z "${arg}" || "${arg}" == "help" || "${arg}" == "--help" || "${arg}" == "-h" ]]; then
        _cc_target_ref[kind]="help"
        _cc_target_ref[consumed]=0
        return 0
    fi

    if [[ "${arg}" == "host" ]]; then
        if [[ -z "${second}" ]]; then
            _cc_die "usage: ccw host <port> [claude-options...]"
            return 1
        fi
        port="$(_cc_normalize_port "${second}")" || {
            _cc_die "Invalid local inference-server port '${second}' (expected 1-65535)."
            return 1
        }
        host="$(_cc_host_gateway)" || {
            _cc_die "cannot determine the IPv4 default gateway for 'host' mode."
            _cc_info "Use 'ccw <ip> <port>' to pass the address explicitly."
            return 1
        }
        _cc_target_ref[kind]="local"
        _cc_target_ref[host]="${host}"
        _cc_target_ref[port]="${port}"
        _cc_target_ref[consumed]=2
        return 0
    fi

    if [[ "${arg}" =~ ^[0-9]+$ ]]; then
        port="$(_cc_normalize_port "${arg}")" || {
            _cc_die "Invalid local inference-server port '${arg}' (expected 1-65535)."
            return 1
        }
        _cc_target_ref[kind]="local"
        _cc_target_ref[host]="127.0.0.1"
        _cc_target_ref[port]="${port}"
        _cc_target_ref[consumed]=1
        return 0
    fi

    if _cc_is_ipv4 "${arg}" || _cc_is_ipv6 "${arg}"; then
        if [[ -z "${second}" ]]; then
            _cc_die "usage: ccw <ip> <port> [claude-options...]"
            return 1
        fi
        port="$(_cc_normalize_port "${second}")" || {
            _cc_die "Invalid local inference-server port '${second}' (expected 1-65535)."
            return 1
        }
        host="$(_cc_normalize_host "${arg}")" || {
            _cc_die "invalid IP address '${arg}'."
            return 1
        }
        _cc_target_ref[kind]="local"
        _cc_target_ref[host]="${host}"
        _cc_target_ref[port]="${port}"
        _cc_target_ref[consumed]=2
        return 0
    fi

    if [[ "${arg}" =~ ^[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+$ ]]; then
        _cc_die "invalid IPv4 address '${arg}'."
        return 1
    fi

    _cc_target_ref[kind]="backend"
    _cc_target_ref[backend]="${arg}"
    _cc_target_ref[consumed]=1
    return 0
}

_cc_run() {
    local skip_permissions="${1}"
    shift

    local -A target=()
    local backend_name="" local_host="" local_port=""
    local -a backend_env=()

    _cc_resolve_target target "${1:-}" "${2:-}" || return 1

    case "${target[kind]}" in
        help)
            _cc_print_help
            return 0
            ;;
        local)
            local_host="${target[host]}"
            local_port="${target[port]}"
            shift "${target[consumed]}"
            ;;
        backend)
            backend_name="$(_cc_find_backend "${target[backend]}")" || {
                _cc_die "Unknown backend '${target[backend]}'"
                if [[ "${target[backend]}" == "dsv4" ]]; then
                    _cc_info "Note: 'dsv4' was renamed to 'ds'."
                fi
                _cc_info "Run 'ccw help' to see available backends."
                return 1
            }
            if ! _cc_backend_exists "${backend_name}"; then
                _cc_die "Missing config array 'CC_BACKEND_${backend_name}' for backend '${backend_name}'."
                return 1
            fi
            _cc_build_backend_env "${backend_name}" backend_env || return 1
            shift "${target[consumed]}"
            ;;
        *)
            _cc_die "internal error: unresolved launch target."
            return 1
            ;;
    esac

    (
        _cc_clear_claude_env

        if [[ -n "${local_port}" ]]; then
            _cc_preflight_local_backend "${local_host}" "${local_port}" || exit 1
            _cc_apply_env_list "${CC_GLOBAL_ENV[@]}" || exit 1
            _cc_apply_local_backend "${local_host}" "${local_port}" \
                "${CC_LOCAL_DETECTED_MODEL}" "${CC_LOCAL_DETECTED_CONTEXT}" || exit 1
        else
            _cc_apply_env_list "${CC_GLOBAL_ENV[@]}" || exit 1
            _cc_apply_env_list "${backend_env[@]}" || exit 1
        fi

        if [[ "${skip_permissions}" == "yes" ]]; then
            exec claude "$@" --dangerously-skip-permissions
        else
            exec claude "$@"
        fi
    )
}

_cc_validate_config || true

ccw() {
    _cc_run no "$@"
}

ccwp() {
    _cc_run yes "$@"
}
